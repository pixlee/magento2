use Magento\Catalog\Block\Category\View;
use Pixlee\Pixlee\ViewModel\ProductWidget;

/**
 * @var View $block
 * @var ProductWidget $viewModel
 */
$viewModel = $block->getViewModel();
$nativeCategoryId = (int) $block->getCurrentCategory()->getId();
$widgetId = $viewModel->getCDPWidgetId();
?>
<?php if ($viewModel->isActive() && $widgetId !== null): ?>
    <div id="pixlee_container"></div>
    <div id="pixlee_widget_master_container"></div>
    <script type="text/x-magento-init">
        {
            "*": {
                "Pixlee_Pixlee/js/cdp-widget":{
                    "apiKey": "<?= $block->escapeJs($viewModel->getApiKey()) ?>",
                    "widgetId": <?= /* @noEscape */ $widgetId ?>,
                    "nativeCategoryId": <?= /* @noEscape */ $nativeCategoryId ?>
                }
            }
        }
    </script>
<?php endif; ?>
