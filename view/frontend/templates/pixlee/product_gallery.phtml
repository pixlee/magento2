use Magento\Catalog\Block\Product\View;
use Pixlee\Pixlee\ViewModel\ProductWidget;

/**
 * @var View $block
 * @var ProductWidget $viewModel
 */
$viewModel = $block->getViewModel();
$product = $block->getProduct();
$widgetId = $viewModel->getPDPWidgetId();
$accountId = $viewModel->getAccountId();
?>
<?php if ($viewModel->isActive() && $widgetId !== null && $accountId !== null): ?>
    <div id="pixlee_container"></div>
    <div id="pixlee_widget_master_container"></div>
    <script type="text/x-magento-init">
        {
            "*": {
                "Pixlee_Pixlee/js/pdp-widget":{
                    "apiKey": "<?= $block->escapeJs($viewModel->getApiKey()) ?>",
                    "widgetId": <?= /* @noEscape */ $widgetId ?>,
                    "skuId": "<?= $block->escapeJs($product->getSku()) ?>",
                    "accountId": <?= /* @noEscape */ $accountId ?>
                }
            }
        }
    </script>
<?php endif; ?>
